{
  // Publicação do Worker existente após `pnpm build`.
  "name": "sgb",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  },
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sgb-db",
      "database_id": "501e257e-e6fe-4720-b326-b36cd015a239",
      "migrations_dir": "drizzle"
    }
  ]
}
